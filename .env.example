# Copy this file to .env and fill in the value:
#     cp .env.example .env
#
# .env is gitignored - your key never gets committed.

# Required for book search and book details to return data.
# Google no longer serves the Books API without a key: keyless requests get a
# per-day quota of 0 and always fail with HTTP 429.
#
# To get one:
#   1. https://console.cloud.google.com  ->  create or select a project
#   2. APIs & Services -> Library -> "Books API" -> Enable
#   3. APIs & Services -> Credentials -> Create credentials -> API key
#
# On Render, do NOT use this file. Set the same variable under
# Environment -> Add Environment Variable in the dashboard.
GOOGLE_BOOKS_API_KEY=
